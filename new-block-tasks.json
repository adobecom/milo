      "blockName": "forge-dark-act",
      "sectionHtml": "<section data-binding-source=\"judge\" data-binding-score=\"0.85\" data-binding=\"tight-variant\" data-block=\"rich-content\" class=\"dark-act summit\" data-section=\"summit\" data-intent=\"drive event attendance\" data-layout=\"split-media\" data-media=\"image\">\n    <div class=\"wrap summit__grid\">\n      <div>\n        <p class=\"eyebrow\" style=\"color:var(--text-subtle-dark)\">Adobe Summit</p>\n        <h2 class=\"summit__title\" style=\"margin-top:16px\">Discover what's next in marketing, creativity, and AI at Adobe Summit.</h2>\n        <p class=\"summit__body\">Adobe Summit is the flagship customer experience event, bringing together Adobe leaders, product experts, and top brands for groundbreaking announcements and an exclusive look at the latest innovations from Adobe Labs. Watch sessions online to grow your skillset and stay ahead of the latest digital experience trends.</p>\n        <a class=\"ds-btn ds-btn--primary summit__cta\" href=\"https://summit.adobe.com/na/\">Tune in virtually <span class=\"arrow\" aria-hidden=\"true\">→</span></a>\n      </div>\n      <div class=\"summit__media\">\n        <img src=\"data:image/webp;base64,\" alt=\"Adobe Summit\" width=\"900\" height=\"450\" loading=\"lazy\" decoding=\"async\" />\n      </div>\n    </div>\n  </section>",
      "authorContentHtml": "<p>Adobe Summit</p>\n        <h2>Discover what's next in marketing, creativity, and AI at Adobe Summit.</h2>\n        <p>Adobe Summit is the flagship customer experience event, bringing together Adobe leaders, product experts, and top brands for groundbreaking announcements and an exclusive look at the latest innovations from Adobe Labs. Watch sessions online to grow your skillset and stay ahead of the latest digital experience trends.</p>\n        <a href=\"https://summit.adobe.com/na/\">Tune in virtually →</a>\n<picture><img src=\"data:image/webp;base64,\" alt=\"Adobe Summit\" width=\"900\" height=\"450\" loading=\"lazy\"></picture>",
      "scopedCss": ".forge-dark-act img {max-width:100%;display:block;}\n\n.forge-dark-act .wrap {max-width:var(--max-width);margin-inline:auto;padding-inline:24px;}\n\n.forge-dark-act .eyebrow {font-family:var(--body-font-family);font-size:13px;font-weight:700;\n  letter-spacing:0.04em;color:var(--gray-700);margin:0;}\n\n.forge-dark-act .ds-btn {display:inline-flex;align-items:center;justify-content:center;gap:8px;\n  height:44px;padding-inline:24px;border:1.5px solid transparent;border-radius:var(--radius-pill);\n  font-family:var(--body-font-family);font-size:14px;font-weight:700;letter-spacing:0;\n  text-decoration:none;cursor:pointer;transition:background 200ms var(--ease),color 200ms var(--ease),border-color 200ms var(--ease);white-space:nowrap;}\n\n.forge-dark-act .ds-btn--primary {background:var(--color-accent);color:var(--s2a-color-gray-25, #fff);}\n\n.forge-dark-act .ds-btn--primary:hover {background:var(--color-accent-hover);color:var(--s2a-color-gray-25, #fff);}\n\n.forge-dark-act .arrow {transition:transform 200ms var(--ease);}\n\n.forge-dark-act .ds-btn:hover .arrow, .forge-dark-act .newsrow:hover .arrow {transform:translateX(3px);}\n\n.forge-dark-act .nav-links .ds-btn {height:40px;margin-left:8px;}\n\n.forge-dark-act {background:var(--color-bg-dark);color:var(--color-ink-inverse);}\n\n.forge-dark-act h2, .forge-dark-act h3 {color:var(--s2a-color-gray-25, #fff);}\n\n.forge-dark-act .facts .eyebrow {color:var(--s2a-color-gray-25, #fff);}\n\n.forge-dark-act .facts .eyebrow {color:var(--text-subtle-dark);}\n\n.forge-dark-act {border-top:1px solid var(--hairline-dark);padding-block:var(--section-padding);}\n\n.forge-dark-act .summit__grid {display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}\n\n.forge-dark-act .summit__title {font-size:var(--heading-xl);letter-spacing:-0.02em;color:var(--s2a-color-gray-25, #fff);}\n\n.forge-dark-act .summit__body {margin-top:24px;color:var(--text-subtle-dark);font-size:var(--body-lg);line-height:1.5;max-width:52ch;}\n\n.forge-dark-act .summit__cta {margin-top:32px;}\n\n.forge-dark-act .summit__media {border-radius:var(--radius);overflow:hidden;aspect-ratio:16/8;background:#111;}\n\n.forge-dark-act .summit__media img {width:100%;height:100%;object-fit:cover;}\n\n@media (max-width:900px) {\n.forge-dark-act .summit__grid {grid-template-columns:1fr;gap:36px;}\n}\n\n@media (max-width:640px) {\n.forge-dark-act .wrap {padding-inline:18px;}\n.forge-dark-act .nav-links .ds-btn {margin-left:0;width:100%;}\n}",
      "distinctive": false,
      "pageGlobalsCss": ":root {\n  --heading-font-family:'adobe-clean-display','Adobe Clean Display','Adobe Clean',-apple-system,'Helvetica Neue',Arial,sans-serif;\n  --body-font-family:'adobe-clean','Adobe Clean',-apple-system,'Helvetica Neue',Arial,sans-serif;\n\n  --heading-xxl:clamp(40px,6.25vw,80px);  /* display / hero */\n  --heading-xl:clamp(34px,4.4vw,48px);    /* headline / section titles */\n  --heading-lg:clamp(28px,3.2vw,36px);\n  --heading-md:24px;                       /* title-4 / card names */\n  --body:16px;\n  --body-lg:20px;\n  --body-sm:14px;\n\n  --line-height-heading:1.0;\n  --line-height-body:1.5;\n\n  /* colors */\n  --color-bg:#ffffff;      /* paper */\n  --color-fg:#000000;      /* ink */\n  --color-accent:#3b63fb;  /* Adobe Blue — the single voice */\n  --color-accent-hover:#274dea;\n  --color-ink-inverse:#ffffff;\n  --surface-stone:#eceae7;\n  --surface-cloud:#f8f8f8;\n  --color-bg-dark:#000000;\n  --gray-700:#505050;\n  --text-subtle:rgba(0,0,0,0.64);\n  --text-subtle-dark:rgba(255,255,255,0.72);\n  --hairline:rgba(0,0,0,0.12);\n  --hairline-dark:rgba(255,255,255,0.16);\n  --adobe-red:#eb1000;     /* wordmark ONLY */\n\n  --spacing-xs:4px;\n  --spacing-sm:8px;\n  --spacing-md:16px;\n  --spacing-lg:24px;\n  --spacing-xl:48px;\n  --spacing-2xl:96px;\n\n  --section-padding:80px;  /* desktop; see DESIGN.md § Layout note A2 */\n  --max-width:1200px;\n  --radius:16px;\n  --radius-sm:12px;\n  --radius-pill:999px;\n\n  --ease:cubic-bezier(0.42,0,0,1);\n}\n\n*,*::before,*::after {box-sizing:border-box;}\n\nhtml {-webkit-text-size-adjust:100%;hanging-punctuation:first;scroll-behavior:smooth;}\n\nbody {margin:0;background:var(--color-bg);color:var(--color-fg);\n  font-family:var(--body-font-family);font-size:var(--body);line-height:var(--line-height-body);\n  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}",
