      "name": "forge-work-smarter-than-ever-with-documents",
      "blockName": "forge-work-smarter-than-ever-with-documents",
      "sectionHtml": "<section data-binding-score=\"0.69\" data-binding=\"ambiguous\" data-figma-node-id=\"11612:14406\" data-block=\"base-card\" style=\"width:100%;background:#ffffff;\" data-section-style=\"parallax-featured-card-media\">\n  <style>\n    .col3-wrap{max-width:1920px;margin:0 auto;padding:0 220px;box-sizing:border-box;}\n    .col3-grid{display:flex;flex-direction:row;gap:8px;width:100%;}\n    .col3-col{flex:1;min-width:0;display:flex;flex-direction:column;}\n    .col3-card{position:relative;width:100%;aspect-ratio:488/366;border-radius:16px;overflow:hidden;flex-shrink:0;}\n    .col3-card-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}\n    .col3-copy{display:flex;flex-direction:column;gap:24px;padding:24px 24px 0 24px;}\n    .col3-headline{margin:0;font-family:'Adobe Clean Display','Adobe Clean',Arial,sans-serif;font-weight:900;font-size:24px;line-height:24px;letter-spacing:-0.48px;color:#000000;}\n    .col3-body{margin:0;font-family:'Adobe Clean',Arial,sans-serif;font-weight:400;font-size:16px;line-height:20px;color:rgba(0,0,0,0.64);}\n    .col3-cta{display:inline-flex;flex-direction:row;align-items:center;gap:8px;text-decoration:none;cursor:pointer;}\n    .col3-cta-label{font-family:'Adobe Clean',Arial,sans-serif;font-weight:700;font-size:14px;line-height:18px;color:#000000;}\n    .col3-chip{display:flex;align-items:center;gap:7px;padding:11px 12px 11px 11px;background:#ffffff;border-radius:9px;box-shadow:0 0 4px 1px rgba(0,0,0,0.25);white-space:nowrap;}\n    .col3-chip-text{font-family:'Adobe Clean',Arial,sans-serif;font-weight:400;font-size:16px;line-height:20px;letter-spacing:-0.16px;color:#292929;}\n    @media(max-width:1024px){\n      .col3-wrap{padding:0 40px;}\n      .col3-grid{flex-direction:column;}\n      .col3-col{width:100%;}\n    }\n    @media(max-width:768px){\n      .col3-wrap{padding:0 20px;}\n    }\n  </style>\n\n  <div class=\"col3-wrap\">\n    <div class=\"col3-grid\">\n\n      <!-- Column 1: Acrobat -->\n      <div class=\"col3-col\">\n        <div class=\"col3-card\" style=\"background:#000000;\" data-node-id=\"11612:14408\">\n          <!-- Background: Acrobat app screenshot -->\n          <img src=\"media_4-14-beyond-page-bappadobeacrobatpro.png\" alt=\"Adobe Acrobat Pro\" class=\"col3-card-img\" data-node-id=\"11612:14409\" />\n\n          <!-- Screenshot overlay 9 — fill data: left:84px top:103px in section = same within this first card -->\n          <img src=\"media_4-14-beyond-page-fillf56e4593a808.png\" data-node-id=\"11612:14412\" alt=\"Screenshot 2025-10-27 at 5.56.19 PM 9\" style=\"position:absolute;left:calc(84/488*100%);top:calc(103/366*100%);width:calc(358/488*100%);height:auto;border-radius:8px;display:block;\" />\n\n          <!-- Screenshot 10 — layered slightly behind/offset for depth -->\n          <img src=\"media_4-14-beyond-page-screenshot20251027At55619Pm10.png\" data-node-id=\"11612:14413\" alt=\"Screenshot 2025-10-27 at 5.56.19 PM 10\" style=\"position:absolute;left:calc(96/488*100%);top:calc(115/366*100%);width:calc(340/488*100%);height:auto;border-radius:8px;display:block;\" />\n\n          <!-- Generate presentation chip -->\n          <div class=\"col3-chip\" data-node-id=\"11612:14414\" style=\"position:absolute;left:calc(155/488*100%);bottom:calc(55/366*100%);\">\n            <img src=\"media_4-14-beyond-page-Suggestedgenerate.png\" alt=\"Generate\" style=\"width:18px;height:18px;display:block;\" data-node-id=\"11612:14416\" />\n            <img src=\"media_4-14-beyond-page-s2iconpresentation20n.png\" alt=\"Presentation\" style=\"width:18px;height:18px;display:block;\" data-node-id=\"11612:14417\" />\n            <span class=\"col3-chip-text\" data-node-id=\"11612:14422\">Generate presentation</span>\n          </div>\n\n          <!-- PDF Spaces chip -->\n          <div data-node-id=\"11612:14424\" style=\"position:absolute;left:calc(18/488*100%);top:calc(91/366*100%);display:flex;align-items:center;gap:7.5px;padding:10px 11.25px 10px 10px;background:#ffffff;border-radius:10px;box-shadow:0 0 4.02px 1px rgba(0,0,0,0.25);white-space:nowrap;\">\n            <img src=\"media_4-14-beyond-page-frame2.png\" alt=\"AI\" style=\"width:20px;height:20px;display:block;overflow:hidden;\" data-node-id=\"11612:14435\" />\n            <img src=\"media_4-14-beyond-page-s2iconpresentation20n.png\" alt=\"Presentation\" style=\"width:18px;height:18px;display:block;\" />\n            <span style=\"font-family:'Adobe Clean',Arial,sans-serif;font-weight:400;font-size:16px;line-height:20px;color:#292929;\" data-node-id=\"11612:14440\">PDF Spaces</span>\n          </div>\n        </div>\n\n        <div class=\"col3-copy\" data-node-id=\"11612:14441\">\n          <div style=\"display:flex;flex-direction:column;gap:8px;\" data-node-id=\"11612:14442\">\n            <h3 class=\"col3-headline\" data-node-id=\"11612:14443\">Work smarter than ever with documents.</h3>\n            <p class=\"col3-body\" data-node-id=\"11612:14444\">Trusted PDF tools, now with AI for editing, insights, and content creation.</p>\n          </div>\n          <a href=\"#\" class=\"col3-cta\" data-node-id=\"11612:14445\">\n            <span class=\"col3-cta-label\" data-node-id=\"11612:14446\">Explore Acrobat</span>\n            <svg width=\"6\" height=\"10\" viewBox=\"0 0 6 10\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" data-node-id=\"11612:14447\"><path d=\"M1 1.5L5 5L1 8.5\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" ></path></svg>\n          </a>\n        </div>\n      </div>\n\n      <!-- Column 2: Firefly -->\n      <div class=\"col3-col\">\n        <div class=\"col3-card\" style=\"background:#cecece;\" data-node-id=\"11612:14449\">\n          <!-- Base photo: upscaling comparison image -->\n          <img src=\"media_4-14-beyond-page-image.png\" alt=\"Firefly image upscaling\" class=\"col3-card-img\" data-node-id=\"11612:14450\" />\n          <!-- Firefly app badge / UI overlay -->\n          <img src=\"media_4-14-beyond-page-bappadobefirefly.png\" alt=\"Adobe Firefly\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;transform:rotate(0.004deg);\" data-node-id=\"11612:14453\" />\n        </div>\n\n        <div class=\"col3-copy\" data-node-id=\"11612:14454\">\n          <div style=\"display:flex;flex-direction:column;gap:8px;\" data-node-id=\"11612:14455\">\n            <h3 class=\"col3-headline\" data-node-id=\"11612:14456\">Upscale images instantly with AI.</h3>\n            <p class=\"col3-body\" style=\"line-height:21px;letter-spacing:0.16px;color:rgba(0,0,0,0.6);\" data-node-id=\"11612:14457\">Improve resolution, clarity, and sharpness while preserving detail—perfect for photos, designs, and creatives.</p>\n          </div>\n          <a href=\"#\" class=\"col3-cta\" data-node-id=\"11612:14458\">\n            <span class=\"col3-cta-label\" style=\"line-height:17px;\" data-node-id=\"11612:14459\">Explore Firefly</span>\n            <svg width=\"6\" height=\"10\" viewBox=\"0 0 6 10\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" data-node-id=\"11612:14460\"><path d=\"M1 1.5L5 5L1 8.5\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" ></path></svg>\n          </a>\n        </div>\n      </div>\n\n      <!-- Column 3: Photoshop Harmonize -->\n      <div class=\"col3-col\">\n        <!-- Fill image for PS_Harmonize (fill of node 11612:14462, 488×366, at left:992px top:0px in section) -->\n        <img src=\"media_4-14-beyond-page-fill0259666dbf09.png\" data-node-id=\"11612:14462\" alt=\"PS Harmonize — car composited into desert landscape\" style=\"width:100%;aspect-ratio:488/366;border-radius:16px;object-fit:cover;display:block;flex-shrink:0;background:#000000;\" />\n\n        <div class=\"col3-copy\" data-node-id=\"11612:14480\">\n          <div style=\"display:flex;flex-direction:column;gap:8px;\" data-node-id=\"11612:14481\">\n            <h3 class=\"col3-headline\" data-node-id=\"11612:14482\">Blend images seamlessly with Harmonize.</h3>\n            <p class=\"col3-body\" data-node-id=\"11612:14483\">Combine people and objects into any background instantly.</p>\n          </div>\n          <a href=\"#\" class=\"col3-cta\" data-node-id=\"11612:14484\">\n            <span class=\"col3-cta-label\" style=\"line-height:17px;\" data-node-id=\"11612:14485\">Explore Photoshop</span>\n            <svg width=\"6\" height=\"10\" viewBox=\"0 0 6 10\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" data-node-id=\"11612:14486\"><path d=\"M1 1.5L5 5L1 8.5\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" ></path></svg>\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
