row;align-items:center;gap:7px;height:18px;}\n    .c3-chip-txt{font-family:'Adobe Clean','adobe-clean',system-ui,sans-serif;font-weight:400;font-size:13px;line-height:18px;letter-spacing:-0.13px;color:#292929;white-space:nowrap;}\n    @media(max-width:1280px){.c3-wrap{padding:0 80px;}}\n    @media(max-width:1024px){\n      .c3-wrap{padding:0 40px;}\n      .c3-grid{flex-direction:column;gap:24px;}\n      .c3-col{width:100%;}\n      .c3-card{height:320px;}\n    }\n    @media(max-width:768px){\n      .c3-wrap{padding:0 20px;}\n      .c3-card{height:260px;}\n      .c3-headline{font-size:20px;line-height:22px;}\n      .c3-body,.c3-body-ff{font-size:15px;}\n    }\n  </style>\n\n  <div class=\"c3-wrap\">\n    <div class=\"c3-grid\">\n\n      <!-- Column 1 – Acrobat -->\n      <div class=\"c3-col\" data-node-id=\"11612:14407\">\n        <div class=\"c3-card\" style=\"background:#000000;\" data-node-id=\"11612:14408\">\n          <img class=\"c3-card-bg\" src=\"media_4-14-beyond-page-bappadobeacrobatpro.png\" alt=\"B_app_AdobeAcrobatPro\" data-node-id=\"11612:14409\" />\n\n          <!-- Primary chip: Gemini 3 -->\n          <div class=\"c3-chip\" style=\"top:22px;left:16px;\" data-node-id=\"I11612:14410;180:8301;20:486\">\n            <div class=\"c3-chip-row\">\n              <img src=\"media_4-14-beyond-page-Suggestedgenerate.png\" alt=\"Suggested/Generate\" style=\"width:18px;height:18px;flex-shrink:0;\" data-node-id=\"I11612:14410;180:8301;165:21296\" />\n              <span class=\"c3-chip-txt\" style=\"font-size:16px;letter-spacing:-0.16px;\" data-node-id=\"I11612:14410;180:8301;20:489\">Gemini 3</span>\n            </div>\n          </div>\n\n          <!-- Secondary chip: long prompt text -->\n          <div class=\"c3-chip\" style=\"top:78px;left:16px;right:16px;border:1px solid #707070;overflow:hidden;\" data-node-id=\"I11612:14410;180:8887\">\n            <div style=\"display:flex;flex-direction:row;align-items:center;gap:3px;height:18px;overflow:hidden;\">\n              <span class=\"c3-chip-txt\" style=\"overflow:hidden;text-overflow:ellipsis;\" data-node-id=\"I11612:14410;180:8887;180:8444\">Add a dollop of whipped cream and a bright red cherry on top</span>\n            </div>\n          </div>\n\n          <!-- Screenshots group -->\n          <div style=\"position:absolute;top:138px;left:16px;display:flex;flex-direction:column;gap:4px;border-radius:8px;\" data-node-id=\"11612:14411\">\n            <img src=\"media_4-14-beyond-page-screenshot20251027At55619Pm9.png\" alt=\"Screenshot 2025-10-27 at 5.56.19 PM 9\" style=\"max-width:130px;height:auto;border-radius:8px;display:block;background:rgba(255,255,255,.15);\" data-node-id=\"11612:14412\" />\n            <img src=\"media_4-14-beyond-page-screenshot20251027At55619Pm10.png\" alt=\"Screenshot 2025-10-27 at 5.56.19 PM 10\" style=\"max-width:130px;height:auto;border-radius:8px;display:block;background:rgba(255,255,255,.15);\" data-node-id=\"11612:14413\" />\n          </div>\n\n          <!-- Generate presentation chip -->\n          <div class=\"c3-chip\" style=\"bottom:58px;left:16px;\" data-node-id=\"11612:14414\">\n            <div class=\"c3-chip-row\" style=\"gap:7px;\" data-node-id=\"11612:14415\">\n              <img src=\"media_4-14-beyond-page-Suggestedgenerate.png\" alt=\"Suggested/Generate\" style=\"width:18px;height:18px;flex-shrink:0;\" data-node-id=\"11612:14416\" />\n              <img src=\"media_4-14-beyond-page-s2iconpresentation20n.png\" alt=\"S2_Icon_Presentation_20_N\" style=\"width:18px;height:18px;flex-shrink:0;\" data-node-id=\"11612:14417\" />\n              <span class=\"c3-chip-txt\" style=\"font-size:16px;letter-spacing:-0.16px;\" data-node-id=\"11612:14422\">Generate presentation</span>\n            </div>\n          </div>\n\n          <!-- PDF Spaces chip -->\n          <div style=\"position:absolute;bottom:14px;left:16px;display:flex;align-items:center;justify-content:center;padding:10px 11px 10px 10px;border-radius:10px;background:#ffffff;overflow:hidden;box-shadow:0 0 4px 1px rgba(0,0,0,.25);\" data-node-id=\"11612:14424\">\n            <div style=\"display:flex;flex-direction:row;align-items:center;gap:7.5px;\" data-node-id=\"11612:14425\">\n              <img src=\"media_4-14-beyond-page-frame2.png\" alt=\"Frame\" style=\"width:20px;height:20px;flex-shrink:0;overflow:hidden;\" data-node-id=\"11612:14435\" />\n              <span style=\"font-family:'Adobe Clean','adobe-clean',system-ui,sans-serif;font-weight:400;font-size:16px;line-height:20px;color:#292929;white-space:nowrap;\" data-node-id=\"11612:14440\">PDF Spaces</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"c3-copy\" data-node-id=\"11612:14441\">\n          <div class=\"c3-hb\" data-node-id=\"11612:14442\">\n            <p class=\"c3-headline\" data-node-id=\"11612:14443\">Work smarter than ever with documents.</p>\n            <p class=\"c3-body\" data-node-id=\"11612:14444\">Trusted PDF tools, now with AI for editing, insights, and content creation.</p>\n          </div>\n          <a class=\"c3-cta\" href=\"#\" data-node-id=\"11612:14445\">\n            <span class=\"c3-cta-lbl\" data-node-id=\"11612:14446\">Explore Acrobat</span>\n            <span class=\"c3-arrow\" data-node-id=\"11612:14447\"></span>\n          </a>\n        </div>\n      </div>\n\n      <!-- Column 2 – Firefly -->\n      <div class=\"c3-col\" data-node-id=\"11612:14448\">\n        <div class=\"c3-card\" style=\"background:#cecece;\" data-node-id=\"11612:14449\">\n          <img class=\"c3-card-bg\" src=\"media_4-14-beyond-page-image.png\" alt=\"image\" style=\"background:#c4c4c4;\" data-node-id=\"11612:14450\" />\n          <div style=\"position:absolute;inset:0;background:rgba(196,196,196,.05);\" data-node-id=\"11612:14451\"></div>\n          <img src=\"media_4-14-beyond-page-bappadobefirefly.png\" alt=\"B_app_AdobeFirefly\" style=\"position:absolute;bottom:16px;left:16px;max-width:90px;max-height:90px;object-fit:contain;\" data-node-id=\"11612:14453\" />\n        </div>\n\n        <div class=\"c3-copy\" data-node-id=\"11612:14454\">\n          <div class=\"c3-hb\" data-node-id=\"11612:14455\">\n            <p class=\"c3-headline\" data-node-id=\"11612:14456\">Upscale images instantly with AI.</p>\n            <p class=\"c3-body-ff\" data-node-id=\"11612:14457\">Improve resolution, clarity, and sharpness while preserving detail—perfect for photos, designs, and creatives.</p>\n          </div>\n          <a class=\"c3-cta\" href=\"#\" data-node-id=\"11612:14458\">\n            <span class=\"c3-cta-lbl\" style=\"line-height:17px;\" data-node-id=\"11612:14459\">Explore Firefly</span>\n            <span class=\"c3-arrow\" data-node-id=\"11612:14460\"></span>\n          </a>\n        </div>\n      </div>\n\n      <!-- Column 3 – Photoshop / Harmonize -->\n      <div class=\"c3-col\" data-node-id=\"11612:14461\">\n        <div class=\"c3-card\" style=\"background:#000000;\" data-node-id=\"11612:14462\">\n          <img class=\"c3-card-bg\" src=\"media_4-14-beyond-page-psharmonize.png\" alt=\"PS_Harmonize\" />\n        </div>\n\n        <div class=\"c3-copy\" data-node-id=\"11612:14480\">\n          <div class=\"c3-hb\" data-node-id=\"11612:14481\">\n            <p class=\"c3-headline\" data-node-id=\"11612:14482\">Blend images seamlessly with Harmonize.</p>\n            <p class=\"c3-body\" data-node-id=\"11612:14483\">Combine people and objects into any background instantly.</p>\n          </div>\n          <a class=\"c3-cta\" href=\"#\" data-node-id=\"11612:14484\">\n            <span class=\"c3-cta-lbl\" style=\"line-height:17px;\" data-node-id=\"11612:14485\">Explore Photoshop</span>\n            <span class=\"c3-arrow\" data-node-id=\"11612:14486\"></span>\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
      "authorContentHtml": "<picture><img src=\"media_4-14-beyond-page-bappadobeacrobatpro.png\" alt=\"B_app_AdobeAcrobatPro\"></picture>\n<picture><img src=\"media_4-14-beyond-page-Suggestedgenerate.png\" alt=\"Suggested/Generate\"></picture>\n              Gemini 3\nAdd a dollop of whipped cream and a bright red cherry on top\n<picture><img src=\"media_4-14-beyond-page-screenshot20251027At55619Pm9.png\" alt=\"Screenshot 2025-10-27 at 5.56.19 PM 9\"></picture>\n            <picture><img src=\"media_4-14-beyond-page-screenshot20251027At55619Pm10.png\" alt=\"Screenshot 2025-10-27 at 5.56.19 PM 10\"></picture>\n<picture><img src=\"media_4-14-beyond-page-Suggestedgenerate.png\" alt=\"Suggested/Generate\"></picture>\n              <picture><img src=\"media_4-14-beyond-page-s2iconpresentation20n.png\" alt=\"S2_Icon_Presentation_20_N\"></picture>\n              Generate presentation\n<picture><img src=\"media_4-14-beyond-page-frame2.png\" alt=\"Frame\"></picture>\n              PDF Spaces\n<p>Work smarter than ever with documents.</p>\n            <p>Trusted PDF tools, now with AI for editing, insights, and content creation.</p>\n<a href=\"#\">\n            Explore Acrobat\n</a>\n<picture><img src=\"media_4-14-beyond-page-image.png\" alt=\"image\"></picture>\n<picture><img src=\"media_4-14-beyond-page-bappadobefirefly.png\" alt=\"B_app_AdobeFirefly\"></picture>\n<p>Upscale images instantly with AI.</p>\n            <p>Improve resolution, clarity, and sharpness while preserving detail—perfect for photos, designs, and creatives.</p>\n<a href=\"#\">\n            Explore Firefly\n</a>\n<picture><img src=\"media_4-14-beyond-page-psharmonize.png\" alt=\"PS_Harmonize\"></picture>\n<p>Blend images seamlessly with Harmonize.</p>\n            <p>Combine people and objects into any background instantly.</p>\n<a href=\"#\">\n            Explore Photoshop\n</a>",
