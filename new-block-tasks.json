card--3 {\n    width: 370px;\n    height: 734px;\n    background: #e2e2e2;\n    transform: rotate(-0.478deg);\n  }\n  .offer-sec__card--3 img { height: 734px; }\n  .offer-sec__gradient {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n    height: 480px;\n    background: linear-gradient(0deg, #f6f6f6 0%, rgba(246, 246, 246, 0) 100%);\n    pointer-events: none;\n    z-index: 10;\n  }\n\n  /* ── 1024 px breakpoint ── */\n  @media (max-width: 1024px) {\n    .offer-sec { min-height: auto; padding: 72px 0 56px; }\n    .offer-sec__inner { min-height: auto; padding: 0 24px; box-sizing: border-box; }\n    .offer-sec__rect-bg,\n    .offer-sec__rect-shadow { display: none; }\n    .offer-sec__cards {\n      position: relative;\n      top: auto; left: auto;\n      transform: none;\n      width: 100%;\n      gap: 16px;\n    }\n    .offer-sec__card--1,\n    .offer-sec__card--2,\n    .offer-sec__card--3 {\n      width: calc(33.33% - 11px);\n      height: auto;\n      aspect-ratio: 3 / 5;\n      margin-top: 0;\n    }\n    .offer-sec__card--1 img,\n    .offer-sec__card--2 img,\n    .offer-sec__card--3 img { height: 100%; }\n    .offer-sec__gradient { height: 120px; }\n  }\n\n  /* ── 768 px breakpoint ── */\n  @media (max-width: 768px) {\n    .offer-sec { padding: 52px 0 72px; }\n    .offer-sec__inner { padding: 0 20px; }\n    .offer-sec__cards {\n      flex-direction: column;\n      align-items: center;\n      gap: 20px;\n    }\n    .offer-sec__card--1,\n    .offer-sec__card--2,\n    .offer-sec__card--3 {\n      width: 100%;\n      max-width: 400px;\n      height: auto;\n      aspect-ratio: 4 / 5;\n      transform: none;\n    }\n  }\n</style>\n\n  <div class=\"offer-sec__bg\"></div>\n\n  <div class=\"offer-sec__inner\">\n\n    <!-- Rectangle 2147231596 — decorative background card -->\n    <div class=\"offer-sec__rect-bg\"></div>\n\n    <!-- Rectangle 2147231600 — shadow accent -->\n    <div class=\"offer-sec__rect-shadow\"></div>\n\n    <!-- Three rotated image cards -->\n    <div class=\"offer-sec__cards\">\n\n      <div class=\"offer-sec__card offer-sec__card--1\">\n        <img src=\"media_bizpro-hub-rectangle2147231599.png\" alt=\"Rectangle 2147231599\" />\n      </div>\n\n      <div class=\"offer-sec__card offer-sec__card--2\">\n        <img src=\"media_bizpro-hub-rectangle2147231598.png\" alt=\"Rectangle 2147231598\" />\n      </div>\n\n      <div class=\"offer-sec__card offer-sec__card--3\">\n        <img src=\"media_bizpro-hub-rectangle2147231597.png\" alt=\"Rectangle 2147231597\" />\n      </div>\n\n    </div>\n\n    <!-- Flow → Grid to UI: gradient transition zone -->\n    <div class=\"offer-sec__gradient\"></div>\n\n  </div>\n\n</section>",
