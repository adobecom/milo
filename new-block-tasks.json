      "pageGlobalsCss": ":root {\n  /* ---- token contract (skills/stardust/reference/token-contract.md) ---- */\n  --heading-font-family:'adobe-clean-display','Adobe Clean Display','Adobe Clean',-apple-system,'Helvetica Neue',Arial,sans-serif;\n  --body-font-family:'adobe-clean','Adobe Clean',-apple-system,'Helvetica Neue',Arial,sans-serif;\n\n  --heading-xxl:clamp(40px,6.25vw,80px);\n  --heading-xl:clamp(34px,4.4vw,56px);\n  --heading-lg:40px;\n  --heading-md:24px;\n  --body:20px;\n  --body-sm:16px;\n\n  --line-height-heading:1.0;\n  --line-height-body:1.5;\n\n  --color-bg:#ffffff;   /* paper */\n  --color-fg:#000000;   /* ink */\n  --color-accent:#3b63fb; /* Adobe Blue — the only saturated color */\n\n  --spacing-xs:8px;\n  --spacing-sm:16px;\n  --spacing-md:24px;\n  --spacing-lg:32px;\n  --spacing-xl:48px;\n  --spacing-2xl:96px;\n\n  --section-padding:96px;\n  --max-width:1200px;\n  --radius:16px;\n\n  /* ---- extended C2 tokens ---- */\n  --stone:#eceae7;\n  --cloud:#f8f8f8;\n  --ink-body:#2c2c2c;\n  --secondary:rgba(0,0,0,0.64);\n  --subtle:#505050;\n  --blue-hover:#274dea;\n  --dark:#000000;\n  --on-dark:#ffffff;\n  --on-dark-subtle:rgba(255,255,255,0.72);\n  --on-dark-hairline:rgba(255,255,255,0.16);\n  --hairline:rgba(0,0,0,0.10);\n  --red:#eb1000;              /* reserved to the Adobe wordmark */\n  --radius-inner:12px;\n  --radius-section:32px;\n  --ease:cubic-bezier(0.42,0,0,1);\n}\n\n* {box-sizing:border-box;}\n\nhtml {-webkit-text-size-adjust:100%;hanging-punctuation:first;}\n\nbody {\n  margin:0;background:var(--color-bg);color:var(--ink-body);\n  font-family:var(--body-font-family);font-size:var(--body-sm);\n  line-height:var(--line-height-body);-webkit-font-smoothing:antialiased;\n  text-rendering:optimizeLegibility;\n}",
