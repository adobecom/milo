      "authorContentHtml": "<picture><img src=\"data:image/webp;base64,\" alt=\"\"></picture>\n        <h2>Contact our team.</h2>\n        <p>Direct all press inquiries to <a href=\"mailto:adobepr@adobe.com\">adobepr@adobe.com</a>.<br>Direct all industry analyst inquiries to <a href=\"mailto:adobear@adobe.com\">adobear@adobe.com</a>.</p>\n<a href=\"https://www.adobe.com/about-adobe.html\"><picture><img src=\"data:image/svg+xml;base64,\" alt=\"\"></picture>About Adobe→</a>\n        <a href=\"https://www.adobe.com/corporate-responsibility.html\"><picture><img src=\"data:image/svg+xml;base64,\" alt=\"\"></picture>Corporate Responsibility→</a>\n        <a href=\"https://www.adobe.com/investor-relations.html\"><picture><img src=\"data:image/svg+xml;base64,\" alt=\"\"></picture>Investor Relations→</a>",
      "scopedCss": ".forge-act2 img {max-width:100%;display:block;}\n\n.forge-act2 .wrap {max-width:var(--max-width);margin-inline:auto;padding-inline:24px;}\n\n.forge-act2 .btn .arw {transition:transform 200ms var(--ease);}\n\n.forge-act2 .btn:hover .arw {transform:translateX(3px);}\n\n.forge-act2 {background:var(--dark);color:var(--on-dark);}\n\n.forge-act2 h2, .forge-act2 h3 {color:var(--on-dark);}\n\n.forge-act2 .sec-head p {color:var(--on-dark-subtle);}\n\n.forge-act2 {border-top:1px solid var(--on-dark-hairline);}\n\n.forge-act2 .lede {max-width:640px;margin:0 auto;text-align:center;}\n\n.forge-act2 .info-ic {width:56px;height:56px;margin:0 auto 24px;}\n\n.forge-act2 .inq {margin-top:20px;color:var(--on-dark-subtle);font-size:var(--body);line-height:1.6;}\n\n.forge-act2 .inq a {color:var(--on-dark);border-bottom:1px solid rgba(255,255,255,0.4);}\n\n.forge-act2 .inq a:hover {color:var(--on-dark);border-color:var(--on-dark);}\n\n.forge-act2 .tiles {display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:820px;margin:48px auto 0;}\n\n.forge-act2 .tile {display:flex;align-items:center;gap:16px;background:rgba(255,255,255,0.04);border:1px solid var(--on-dark-hairline);\n  border-radius:var(--radius-inner);padding:20px 24px;color:var(--on-dark);font-weight:700;font-size:15px;\n  transition:background 200ms var(--ease);}\n\n.forge-act2 .tile:hover {background:rgba(255,255,255,0.08);color:var(--on-dark);}\n\n.forge-act2 .tile img {width:28px;height:28px;object-fit:contain;flex:none;}\n\n.forge-act2 .tile .arw {margin-left:auto;color:var(--on-dark-subtle);}\n\n@media (max-width:900px) {\n.forge-act2 .tiles {grid-template-columns:1fr 1fr;}\n}\n\n@media (max-width:640px) {\n.forge-act2 .wrap {padding-inline:20px;}\n.forge-act2 .tiles {grid-template-columns:1fr;}\n}",
