      "sectionHtml": "<section data-binding-score=\"0.65\" data-binding=\"ambiguous\" data-figma-node-id=\"11612:14387\" data-block=\"rich-content\" style=\"width:100%;background:#ffffff;padding:48px 0;\">\n  <div style=\"max-width:1480px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:32px;padding:0 20px;box-sizing:border-box;\">\n    <!-- Copy -->\n    <div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;width:100%;text-align:center;\">\n      <p style=\"margin:0;font-family:'Adobe Clean',adobe-clean,sans-serif;font-weight:700;font-size:16px;line-height:21px;letter-spacing:-0.16px;color:rgba(0,0,0,0.6);\">Features and Releases</p>\n      <h1 style=\"margin:0;font-family:'Adobe Clean Display',adobe-clean-display,'Adobe Clean',sans-serif;font-weight:900;font-size:56px;line-height:56px;letter-spacing:-1.68px;color:#000000;max-width:984px;text-align:center;\">Explore what’s new.</h1>\n      <p style=\"margin:0;font-family:'Adobe Clean',adobe-clean,sans-serif;font-weight:400;font-size:20px;line-height:26px;letter-spacing:-0.4px;color:#101017;max-width:736px;text-align:center;\">Discover the latest product features from Adobe.</p>\n    </div>\n    <!-- Buttons -->\n    <div style=\"display:flex;flex-direction:row;gap:8px;flex-wrap:wrap;justify-content:center;\">\n      <button type=\"button\" style=\"display:inline-flex;justify-content:center;align-items:center;gap:8px;padding:16px 24px;border-radius:75px;background:#000000;border:none;cursor:pointer;font-family:'Adobe Clean',adobe-clean,sans-serif;font-weight:700;font-size:14px;line-height:17px;color:#ffffff;\">Label</button>\n      <button type=\"button\" style=\"display:inline-flex;justify-content:center;align-items:center;gap:8px;padding:16px 24px;border-radius:75px;background:transparent;border:1px solid #000000;cursor:pointer;font-family:'Adobe Clean',adobe-clean,sans-serif;font-weight:700;font-size:14px;line-height:17px;color:#000000;\">Label</button>\n    </div>\n  </div>\n  <style>\n    @media (max-width:1024px) {\n      [data-figma-node-id=\"11612:14387\"] h2 { font-size:42px; line-height:46px; }\n      [data-figma-node-id=\"11612:14387\"] p:last-of-type { max-width:90%; }\n    }\n    @media (max-width:768px) {\n      [data-figma-node-id=\"11612:14387\"] { padding:36px 0; }\n      [data-figma-node-id=\"11612:14387\"] h2 { font-size:32px; line-height:36px; letter-spacing:-0.8px; }\n      [data-figma-node-id=\"11612:14387\"] p { font-size:16px; line-height:22px; }\n    }\n  </style>\n</section>",
      "authorContentHtml": "<p>Features and Releases</p>\n      <h1>Explore what’s new.</h1>\n      <p>Discover the latest product features from Adobe.</p>\nLabel\n      Label",
