abel {\n  font-family: 'Adobe Clean', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  font-weight: 700;\n  font-size: 14px;\n  line-height: 18px;\n  text-align: center;\n  color: #ffffff;\n  white-space: nowrap;\n}\n@media (max-width: 1280px) {\n  .sdw-copy {\n    width: calc(100% - 120px);\n  }\n}\n@media (max-width: 1024px) {\n  .sdw-wrap {\n    height: 800px;\n  }\n  .sdw-copy {\n    width: calc(100% - 80px);\n    top: 120px;\n  }\n  .sdw-heading {\n    font-size: 44px;\n    line-height: 48px;\n    letter-spacing: -1.2px;\n  }\n  .sdw-sub {\n    font-size: 18px;\n    line-height: 22px;\n  }\n}\n@media (max-width: 768px) {\n  .sdw-wrap {\n    height: 600px;\n  }\n  .sdw-copy {\n    width: calc(100% - 48px);\n    top: 80px;\n  }\n  .sdw-heading {\n    font-size: 32px;\n    line-height: 36px;\n    letter-spacing: -0.6px;\n  }\n  .sdw-sub {\n    font-size: 16px;\n    line-height: 20px;\n  }\n}\n@media (max-width: 480px) {\n  .sdw-wrap {\n    height: 520px;\n  }\n  .sdw-copy {\n    width: calc(100% - 32px);\n    top: 64px;\n  }\n  .sdw-heading {\n    font-size: 26px;\n    line-height: 30px;\n    letter-spacing: -0.3px;\n  }\n  .sdw-sub {\n    font-size: 14px;\n    line-height: 18px;\n  }\n}\n</style>\n\n<div class=\"sdw-wrap\">\n  <!-- Hero background layer: 2880px wide, centred, with dark placeholder colour -->\n  <div class=\"sdw-herobg\" aria-hidden=\"true\"></div>\n\n  <!-- Gradient overlay: black fade at top and bottom, transparent in middle -->\n  <div class=\"sdw-overlay\" aria-hidden=\"true\"></div>\n\n  <!-- Copy lockup -->\n  <div class=\"sdw-copy\" data-figma-node-id=\"10559:113768\">\n\n    <!-- Headline + sub-headline -->\n    <div class=\"sdw-textgroup\" data-figma-node-id=\"10559:113769\">\n      <h2 class=\"sdw-heading\" data-figma-node-id=\"10559:113770\">\n        Tools that work for you.\n      </h2>\n      <p class=\"sdw-sub\" data-figma-node-id=\"10559:113771\">\n        Bring any idea to life with products for creators, businesses, and beyond.